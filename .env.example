# Hercules Hub — names only. Never commit real secrets.
# Netlify AI Gateway injects provider keys + base URLs automatically after a production deploy.
# Leave the AI provider key/base-url variables UNSET in Netlify if you want Gateway-managed credentials.

# Device session / persistence
# Optional. If blank, a stable secret is derived from SUPABASE_SECRET_KEY or Netlify Blobs.
HERCULES_SESSION_SECRET=

# Supabase (optional device-state persistence; no user login required)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alias only when required:
SUPABASE_SERVICE_ROLE_KEY=

# Gateway policy / latency controls (optional; defaults shown)
HERCULES_ALLOW_DIRECT_AI=false
HERCULES_AI_ATTEMPT_TIMEOUT_MS=3500
HERCULES_AI_FALLBACK_BUDGET_MS=7500

# Optional AI model overrides (keys/base URLs are normally injected by Netlify AI Gateway)
OPENAI_MODEL=gpt-5.6-luna
GEMINI_MODEL=gemini-3.7-flash
ANTHROPIC_MODEL=claude-haiku-4-5
OPENROUTER_MODEL=openrouter/auto

# Optional public site URL used only as an OpenRouter request attribution header
HERCULES_SITE_URL=
